# CommerceOps environment (local development)
# Copy to .env and fill in values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL="postgresql://commerceops:commerceops@localhost:5432/commerceops?schema=public"

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me-in-production"

# Base URL of the application (used for trusted redirect URLs)
APP_URL="http://localhost:3000"

# Stripe test mode (only used in M4; tests mock Stripe at the network boundary)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Uploads
UPLOAD_DIR="uploads"