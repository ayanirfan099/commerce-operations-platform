generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CommerceOps data model (M1–M4)
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String
  emailVerified DateTime?

  addresses              Address[]
  cart                   Cart?
  orders                 Order[]
  auditEvents            AuditEvent[]           @relation("AuditActor")
  inventoryLedgerEntries InventoryLedgerEntry[] @relation("InventoryActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  name       String
  street     String
  city       String
  region     String
  postalCode String
  country    String
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([userId])
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  parentId String?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sku         String?   @unique // top-level product SKU
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
  images   ProductImage[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  name      String? // e.g. "Large / Navy"
  isActive  Boolean @default(true)

  prices        Price[]
  images        ProductImage[]
  inventory     InventoryLocation[]
  reservations  InventoryReservation[]
  ledgerEntries InventoryLedgerEntry[]
  orderItems    OrderItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model Price {
  id            String         @id @default(uuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  amount        Int // cents
  currency      String         @default("usd")
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([effectiveFrom])
}

model ProductImage {
  id        String          @id @default(uuid())
  productId String?
  variantId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int             @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
}

model InventoryLocation {
  id                String         @id @default(uuid())
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name              String // warehouse / bin name
  quantity          Int            @default(0) // on-hand stock
  reserved          Int            @default(0) // currently reserved
  lowStockThreshold Int            @default(5)

  ledgerEntries InventoryLedgerEntry[]
  reservations  InventoryReservation[]

  updatedAt DateTime @updatedAt

  @@index([variantId])
  @@index([name])
}

// Append-only ledger: every stock change is a row, never a silent counter edit.
model InventoryLedgerEntry {
  id         String            @id @default(uuid())
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change     Int // positive = inbound, negative = outbound
  reason     String // restock | adjustment | reservation | release | commit | expiry
  actorId    String?
  actor      User?             @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([variantId])
  @@index([createdAt])
  @@index([reason])
}

model InventoryReservation {
  id         String            @id @default(uuid())
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int
  expiresAt  DateTime
  status     ReservationStatus @default(ACTIVE)
  cartId     String?
  cart       Cart?             @relation(fields: [cartId], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([variantId])
  @@index([status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Cart (M1)
// ---------------------------------------------------------------------------

model Cart {
  id        String  @id @default(uuid())
  userId    String? @unique // null => guest cart
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String? @unique // guest cart session token

  items        CartItem[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Orders / payments / promotions / audit (M2–M4; schema defined in M1)
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING_PAYMENT)

  // Snapshot of pricing at purchase time (server-authoritative)
  subtotal Int // cents
  discount Int    @default(0) // cents
  total    Int // cents
  currency String @default("usd")

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])

  items    OrderItem[]
  payments PaymentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshot at purchase time
  name      String
  sku       String
  unitPrice Int // cents
  quantity  Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

model DiscountCode {
  id          String       @id @default(uuid())
  code        String       @unique
  type        DiscountType
  value       Int // percent (0-100) or fixed amount in cents
  minSubtotal Int          @default(0) // cents
  usageLimit  Int? // null = unlimited
  usageCount  Int          @default(0)
  validFrom   DateTime
  validTo     DateTime
  productIds  String? // comma-separated variant ids; null = all products
  categoryIds String? // comma-separated category ids; null = all categories
  isActive    Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

model PaymentAttempt {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String // "fake" | "stripe"
  providerId     String? // provider's payment id
  idempotencyKey String        @unique
  status         PaymentStatus @default(PENDING)
  amount         Int // cents
  currency       String        @default("usd")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refundRecords RefundRecord[]

  @@index([orderId])
  @@index([idempotencyKey])
  @@index([status])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique // Stripe/webhook event id
  provider    String
  type        String
  processed   Boolean   @default(false)
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([processed])
}

model RefundRecord {
  id          String         @id @default(uuid())
  paymentId   String
  payment     PaymentAttempt @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Int // cents
  reason      String?
  providerRef String?

  createdAt DateTime @default(now())

  @@index([paymentId])
}

// Audit log: who/what caused state changes, especially admin actions.
model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "product.create", "order.fulfil", "inventory.adjust"
  targetType String? // e.g. "Product", "Order"
  targetId   String?
  metadata   Json? // structured details
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}
